# Voorbeeldwaarden voor <<SHOP>>.
#
# LET OP: dit bestand staat WEL in Git. Zet hier nooit een echte sleutel of een
# wachtwoord in. Kopieer het naar `.env` en vul daar de echte waarden in; `.env`
# staat in .gitignore.
#
# Staat er ooit toch een echte sleutel in een commit: roteer hem. Een commit
# weghalen haalt de sleutel niet uit de kopieën die anderen al hebben.

# --- De site zelf ---------------------------------------------------------
# Volledig adres mét protocol. Wordt gebruikt voor canonicals, deelplaatjes en
# de terugkeer-URL van de betaaldienst. Op een ontwikkelmachine localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Leverancier ----------------------------------------------------------
# Server-side. Komt nooit in de browser.
SUPPLIER_API_TOKEN=
# Een tweede token als de leverancier meerdere API's heeft met eigen sleutels
# SUPPLIER_SECOND_TOKEN=

# Alleen invullen om naar een andere omgeving te wijzen dan de standaard
# SUPPLIER_BASE_URL=

# --- Prijsbeleid ----------------------------------------------------------
# Minimale marge op de inkoopprijs als er geen adviesprijs is, in procenten
MIN_MARGIN_PERCENT=25
# Op "false" om de adviesprijs van de leverancier te negeren
USE_RECOMMENDED_PRICE=true

# --- Database -------------------------------------------------------------
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Betaaldienst ---------------------------------------------------------
# Een testsleutel op een ontwikkelmachine. Staat hier een live sleutel, dan
# verplaatst elke druk op "betalen" echt geld.
PAYMENT_API_KEY=

# --- Mail -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Afzender en het adres waar bestellingen naartoe gaan
MAIL_FROM=
MAIL_ORDERS_TO=

# --- Beheerpaneel ---------------------------------------------------------
# Sleutel waarmee het tweestapsgeheim versleuteld in de database staat.
# 32 willekeurige bytes, hex. Verlies je hem, dan kan niemand meer inloggen.
ADMIN_TOTP_KEY=

# --- Geplande taken -------------------------------------------------------
# De cron-taak stuurt dit mee als bearer-token
JOB_TOKEN=
