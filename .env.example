# Voorbeeldwaarden voor <<SHOP>>.
#
# LET OP: dit bestand staat WEL in Git. Zet hier nooit een echte sleutel of een
# wachtwoord in — de guard-hook weigert een niet-lege waarde bij variabelen met
# TOKEN, SECRET, PASSWORD of KEY in de naam. Kopieer naar `.env` en vul daar de
# echte waarden in; `.env` staat in .gitignore en is voor Claude niet leesbaar.
#
# Staat er ooit toch een echte sleutel in een commit: roteer hem. Een commit
# weghalen haalt de sleutel niet uit de kopieën die anderen al hebben.
#
# De applicatie valideert deze variabelen bij het opstarten en weigert te
# starten als er een ontbreekt of een verkeerde vorm heeft.

# --- De site zelf ---------------------------------------------------------
# Volledig adres mét protocol: canonicals, deelplaatjes, terugkeer-URL van de
# betaaldienst. De prefix NEXT_PUBLIC_ is framework-specifiek (AANNAME tot
# D-00) en maakt de waarde publiek in de browserbundel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Leverancier ----------------------------------------------------------
# Server-side. Komt nooit in de browser. Leeg = de mock wordt gebruikt.
SUPPLIER_API_TOKEN=
# Aparte sleutel voor bestellen, als de leverancier dat toelaat (D-04)
# SUPPLIER_ORDER_TOKEN=
# Alleen invullen om naar een andere omgeving te wijzen dan de standaard
# SUPPLIER_BASE_URL=
# Mock-scenario in ontwikkeling (docs/SUPPLIER_RESILIENCE.md), bijv. unavailable
# CATALOG_MOCK_SCENARIO=

# --- Prijsbeleid (voorbeeldwaarden; de echte keuze is D-03 en D-16) -------
# Minimale marge op de kostprijs als er geen prijsregel is, in procenten
MIN_MARGIN_PERCENT=25
# Op "false" om de adviesprijs van de leverancier te negeren
USE_RECOMMENDED_PRICE=true

# --- Database (soort en poort volgen uit D-06) ----------------------------
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Betaaldienst (D-05) --------------------------------------------------
# Een testsleutel op een ontwikkelmachine. Een live sleutel hier betekent dat
# elke druk op "betalen" echt geld verplaatst.
PAYMENT_API_KEY=
# Geheim om de handtekening van webhooks te controleren, als de dienst dat biedt
PAYMENT_WEBHOOK_SECRET=

# --- Mail -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Afzender en het adres waar bestellingen naartoe gaan
MAIL_FROM=
MAIL_ORDERS_TO=
# In ontwikkeling: alle mail naar dit adres in plaats van naar de klant
# MAIL_REDIRECT_TO=

# --- Beheerpaneel ---------------------------------------------------------
# Sleutel waarmee het TOTP-geheim versleuteld in de database staat.
# 32 willekeurige bytes, hex. Verlies je hem, dan kan niemand meer inloggen —
# bewaar hem ook in de wachtwoordkluis (docs/DISASTER_RECOVERY.md).
ADMIN_TOTP_KEY=

# --- Geplande taken -------------------------------------------------------
# De cron-taak stuurt dit mee als bearer-token
JOB_TOKEN=
